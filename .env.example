# ============================================================
# Edify Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application ----
APP_NAME=Edify
APP_ENV=development
DEBUG=true

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# ---- Database (PostgreSQL) ----
POSTGRES_USER=edify
POSTGRES_PASSWORD=12345
POSTGRES_DB=edify
POSTGRES_HOST=postgres
POSTGRES_PORT=5435
DATABASE_URL=postgresql+asyncpg://edify:12345@postgres:5432/edify

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---- JWT ----
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Storage ----
STORAGE_PATH=/app/storage
STORAGE_MUSIC_DIR=music
STORAGE_COVERS_DIR=covers
STORAGE_TEMP_DIR=temp
MAX_UPLOAD_SIZE_MB=100

# ---- CORS ----
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json
